+/// What a non-file, non-directory inode is, by its mode's type bits.
+fn special_kind(mode: u16) -> &'static str {
+    match mode & 0xF000 {
+        0x1000 => "FIFO",
+        0x2000 => "character device",
+        0x6000 => "block device",
+        0xA000 => "symlink",
+        0xC000 => "socket",
+        0xE000 => "whiteout",
+        0 => "unallocated inode",
+        _ => "unknown type",
+    }
+}
