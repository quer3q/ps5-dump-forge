-/// Ignored by default: it writes ~117 MiB. Run it with
-/// `cargo test -p ps5upload-fpkg --release --test scale -- --ignored`.
-#[test]
-#[ignore = "writes ~117 MiB to the temp directory"]
-fn a_source_past_the_first_indirect_slot_round_trips() {
