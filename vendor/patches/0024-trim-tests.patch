-        let pkg = build(&req);
-        let mut tree = pkg_source::open(&pkg, DEFAULT_PASSCODE).unwrap();
-        let want = std::fs::read(src.path().join("data/big.bin")).unwrap();
-        let mut at = 0usize;
-        let mut peak = 0usize;
-        while at < want.len() {
-            let piece = tree.read_range("data/big.bin", at as u64, 1 << 20).unwrap();
