+        let mount = 0x4_0400;
+        let image = image_of(vec![b0, b5], mount, mount, mount);
+        let mut blob = assemble(&image, &[0, 0x100, 0x100, 0x200, 0x4_0200, 0x4_0300]).unwrap();
