{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client"],
    // vite.config.ts points this at transport-http.tsx for `--mode http`.
    "paths": { "forge-transport": ["./src/transport-tauri.tsx"] },
    "noEmit": true
  },
  "include": ["src", "vite.config.ts"]
}
