{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: progress and drag-and-drop events, file pickers and the app's own commands. No fs plugin; file access stays in Rust.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "dialog:allow-open",
    "allow-inspect",
    "allow-library-scan",
    "allow-library-cover",
    "allow-host-tree",
    "allow-edit-check",
    "allow-default-output",
    "allow-generated-output",
    "allow-start-job",
    "allow-cancel-job",
    "allow-stale-parts",
    "allow-lz4-patch",
    "allow-lz4-unpatch",
    "allow-delete-path",
    "allow-reveal",
    "allow-open-repo",
    "allow-update-target",
    "allow-open-update",
    "allow-quit-app"
  ]
}
