{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: progress and drag-and-drop events, file pickers and the app's own commands. No fs plugin; file access stays in Rust.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-inspect",
    "allow-library-scan",
    "allow-library-cover",
    "allow-host-tree",
    "allow-edit-check",
    "allow-existing-targets",
    "allow-default-output",
    "allow-generated-output",
    "allow-start-job",
    "allow-cancel-job",
    "allow-stale-parts",
    "allow-delete-path",
    "allow-move-path",
    "allow-list-dir",
    "allow-home-folder",
    "allow-reveal",
    "allow-open-repo",
    "allow-update-target",
    "allow-open-update",
    "allow-quit-app",
    "allow-connect-state",
    "allow-connect-pair",
    "allow-connect-probe",
    "allow-connect-pair-cancel",
    "allow-connect-approve",
    "allow-connect-forget",
    "allow-connect-discover-start",
    "allow-connect-discover-stop",
    "allow-connect-send",
    "allow-connect-fetch",
    "allow-connect-cancel",
    "allow-connect-remote-list",
    "allow-connect-nas-save",
    "allow-connect-nas-forget",
    "allow-connect-cancel-job",
    "allow-connect-install",
    "allow-connect-payload-install",
    "allow-connect-payload-send"
  ]
}
